# .env do BACKEND em PRODUÇÃO (no servidor: backend/.env). Ver docs/GUIA-PRODUCAO.md.
# Em ENV=prod o backend se recusa a subir se faltar algo obrigatório (o log diz o quê).

ENV=prod
APP_NAME=Ísis
TIMEZONE_DEFAULT=America/Sao_Paulo

# Endereço público do painel (o mesmo domínio do site, com https)
FRONTEND_ORIGIN=https://isis.seudominio.com.br
PUBLIC_BASE_URL=https://isis.seudominio.com.br
# Sites de apresentação das clínicas (Etapa 11)
SITE_BASE_URL=https://isis.seudominio.com.br/site

# --- Banco e login: use um projeto Supabase SÓ DE PRODUÇÃO (não o de desenvolvimento!) ---
# Os dados de teste têm telefones inventados: em produção, mensagens automáticas iriam para eles.
# Use a conexão "Session pooler" (porta 5432, funciona em servidor só com IPv4 e aceita o tempo real).
# NÃO use o "Transaction pooler" (porta 6543): ele não suporta o tempo real do painel.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- IA (D36: trocar para uma API paga por uso ANTES do 1º cliente real) ---
LLM_PROVIDER=opencode-go
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_API_STYLE=responses
# A chave acima é a "chave da plataforma" (opcional). Cada clínica cadastra a própria em Configurações › Assistente.

# Chave-mestra que criptografa as chaves de IA das clínicas (OBRIGATÓRIA). Gere com:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde uma cópia em lugar seguro: se ela se perder, as chaves das clínicas precisam ser cadastradas de novo.
IA_CHAVE_MESTRA=

# --- WhatsApp (WAHA no seu servidor, D28) ---
WAHA_API_URL=https://waha.seudominio.com.br
WAHA_API_KEY=
# Gere um segredo novo para produção (64 caracteres aleatórios), ex.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WAHA_WEBHOOK_HMAC_KEY=
# Etapa 36 (D131): WhatsApp oficial (Meta). Dados de cada clínica ficam no banco (cifrados); aqui só a versão da API.
# META_GRAPH_URL=https://graph.facebook.com/v23.0

# --- Mensagens automáticas (lembretes, avisos, aniversário) ---
MENSAGENS_AUTOMATICAS=true
# ENVIO_SOMENTE_PARA só vale em desenvolvimento; em produção as mensagens vão para os pacientes de verdade.
