# =====================================================================
#  Configuração do backend da Ísis
#  Copie para .env e preencha. NUNCA cole estes valores no chat nem no git.
#  Não use aspas e não deixe espaços antes/depois do "=".
# =====================================================================

ENV=dev
FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------
#  SUPABASE — banco de dados
#  Painel do projeto > botão "Connect" (topo) > aba "Connection String"
#  > Method: "Session pooler" > copie a URI e troque [YOUR-PASSWORD]
#  pela senha do banco que você criou junto com o projeto.
#  Formato: postgresql://postgres.SEU_REF:SENHA@aws-X-sa-east-1.pooler.supabase.com:5432/postgres
#  Se a senha tiver @ # / ? % : ou espaço, troque por: @=%40 #=%23 /=%2F ?=%3F %=%25 :=%3A espaço=%20
# ---------------------------------------------------------------------
DATABASE_URL=

# Project Settings > Data API (ou Connect > App Frameworks): "Project URL"
SUPABASE_URL=
# Project Settings > API Keys:
#   chave pública  = "publishable" (sb_publishable_...) ou "anon" (projetos antigos)
#   chave secreta  = "secret" (sb_secret_...) ou "service_role" (projetos antigos) — NUNCA vai para o frontend
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
#  IA — OpenCode Go (decisão D13)
#  opencode.ai > entrar > Zen/Go > API Keys > copie a chave
# ---------------------------------------------------------------------
LLM_PROVIDER=opencode-go
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_API_STYLE=responses
# A chave acima é a "chave da plataforma": opcional em produção. Cada clínica cadastra a própria chave
# em Configurações › Assistente (Etapa 10A); a da plataforma só vale para clínicas em que o admin geral
# ligar "usar a chave da plataforma".

# Etapa 10A — chave-mestra que criptografa as chaves de IA das clínicas. Obrigatória em produção.
# Gere com:  .venv/Scripts/python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde uma cópia em lugar seguro: se ela se perder, as chaves salvas precisam ser cadastradas de novo.
IA_CHAVE_MESTRA=

# Etapa 5 — WhatsApp pelo WAHA (D28). Os dados de cada clínica (sessão) ficam no banco (D31).
WAHA_API_URL=
WAHA_API_KEY=
# Segredo para assinar os webhooks (gere um texto aleatório longo; o script de configuração usa ele)
WAHA_WEBHOOK_HMAC_KEY=
# Etapa 36 (D131): WhatsApp oficial (Meta). Dados de cada clínica ficam no banco (cifrados); aqui só a versão da API.
# META_GRAPH_URL=https://graph.facebook.com/v23.0
# Endereço público do backend (em dev, o do túnel cloudflared)
PUBLIC_BASE_URL=

# Etapa 6 — mensagens automáticas. Em ENV=dev só envia para os telefones abaixo (separados por vírgula).
# Os dados de exemplo têm telefones inventados que podem ser de pessoas reais: deixe só números de teste.
MENSAGENS_AUTOMATICAS=true
# Etapa 13 (D66): mensagens picadas — segundos de silêncio antes de responder (0 = responde cada uma na hora) e o máximo total
WHATSAPP_ESPERA_S=8
WHATSAPP_ESPERA_MAX_S=30
# Etapa 13B (D67): transcrição de áudio do WhatsApp (API compatível com OpenAI; padrão: Whisper da OpenAI).
# Vazio = a assistente pede para a pessoa escrever. O WAHA precisa baixar mídia (WHATSAPP_DOWNLOAD_MEDIA=true, o padrão).
# O custo (US$ por minuto) entra no "Uso da IA" e no teto de cada clínica. Confira o preço atual no provedor.
TRANSCRICAO_API_KEY=
TRANSCRICAO_BASE_URL=https://api.openai.com/v1
TRANSCRICAO_MODELO=whisper-1
TRANSCRICAO_USD_MINUTO=0.006
ENVIO_SOMENTE_PARA=
