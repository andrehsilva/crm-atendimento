# =====================================================================
#  Configuração do backend da Ísis
#  Copie para .env e preencha. NUNCA cole estes valores no chat nem no git.
#  Não use aspas e não deixe espaços antes/depois do "=".
# =====================================================================

ENV=dev
FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------
#  SUPABASE — banco de dados
#  Painel do projeto > botão "Connect" (topo) > aba "Connection String"
#  > Method: "Session pooler" > copie a URI e troque [YOUR-PASSWORD]
#  pela senha do banco que você criou junto com o projeto.
#  Formato: postgresql://postgres.SEU_REF:SENHA@aws-X-sa-east-1.pooler.supabase.com:5432/postgres
#  Se a senha tiver @ # / ? % : ou espaço, troque por: @=%40 #=%23 /=%2F ?=%3F %=%25 :=%3A espaço=%20
# ---------------------------------------------------------------------
DATABASE_URL=

# Project Settings > Data API (ou Connect > App Frameworks): "Project URL"
SUPABASE_URL=
# Project Settings > API Keys:
#   chave pública  = "publishable" (sb_publishable_...) ou "anon" (projetos antigos)
#   chave secreta  = "secret" (sb_secret_...) ou "service_role" (projetos antigos) — NUNCA vai para o frontend
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
#  IA — OpenCode Go (decisão D13)
#  opencode.ai > entrar > Zen/Go > API Keys > copie a chave
# ---------------------------------------------------------------------
LLM_PROVIDER=opencode-go
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_API_STYLE=responses

# Etapa 5 — WhatsApp pelo WAHA (D28). Os dados de cada clínica (sessão) ficam no banco (D31).
WAHA_API_URL=
WAHA_API_KEY=
# Segredo para assinar os webhooks (gere um texto aleatório longo; o script de configuração usa ele)
WAHA_WEBHOOK_HMAC_KEY=
# Endereço público do backend (em dev, o do túnel cloudflared)
PUBLIC_BASE_URL=

# Etapa 6 — mensagens automáticas. Em ENV=dev só envia para os telefones abaixo (separados por vírgula).
# Os dados de exemplo têm telefones inventados que podem ser de pessoas reais: deixe só números de teste.
MENSAGENS_AUTOMATICAS=true
ENVIO_SOMENTE_PARA=
